{
  "rewrites": [
    {
      "source": "/datos.01",
      "destination": "/datos.01/index.html"
    },
    {
      "source": "/ebit",
      "destination": "/ebit/index.html"
    }
  ],
  "headers": [
    {
      "source": "/datos.01(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ebit(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
